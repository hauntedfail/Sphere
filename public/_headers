# Response headers for hosts that read this file (Cloudflare Workers and
# Pages, Netlify).
# The page also carries its Content-Security-Policy in a <meta> tag, so the
# policy holds on hosts that ignore this file. frame-ancestors and the
# permissions policy can only be set here.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
  Permissions-Policy: bluetooth=(self), camera=(), microphone=(), geolocation=(), usb=(), serial=(), hid=(), payment=(), interest-cohort=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000

# Files under /assets/ carry a hash of their contents in their names, so a
# changed file is a new address.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is asked for again on every visit. no-transform tells the
# host to send it exactly as built: without it, Cloudflare's bot detection adds
# an inline script that the policy above then refuses to run, on every visit.
# It is on the page only, because compressing a file is a transformation too.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
